pipeline{
    agent any

    environment{
        PATH = "/usr/share/maven/bin:$PATH"
    }
    stages{
        stage('Git Checkout'){
            steps{
                git branch: 'main', credentialsId: 'github', url: 'https://github.com/shivambhamare/devops-automation'
            }
        }
        stage('Maven build'){
            steps{
                sh "mvn clean package"
                sh "mv target/*.war target/myweb.war"
            }
        }
        stage('deploy-dev'){
            sshagent(['infivit']) {
                sh """
                    scp -o StrictHostKeyChecking=no target/myweb.war infivit@192.168.1.61 
                """
            }
        }
    }
}
